{
  "name": "payments-reconciliation-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "build": "tsc && tsc -p tsconfig.web.json && node scripts/build.mjs",
    "test": "node --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:ui": "playwright test",
    "check": "npm run typecheck && npm run build && npm test && npm run test:ui",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.3",
    "@langchain/langgraph-checkpoint": "1.2.1",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "better-sqlite3": "12.11.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
